# Copy to portal/.env and fill in. portal/.env is gitignored. Never commit real values.
# Generate a secret key:  .venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(50))"
# Generate a DB password: .venv\Scripts\python.exe -c "import secrets; print(secrets.token_hex(16))"

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=UTC

# Used by docker-compose.yml (to create the database) AND by Django (to connect).
POSTGRES_DB=kairos
POSTGRES_USER=kairos
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Optional: overrides the POSTGRES_* values above, e.g. for a managed database.
# DATABASE_URL=postgres://user:password@host:5432/dbname
